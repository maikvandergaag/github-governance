{
  "id": "enterprise.actions-restricted",
  "scope": "enterprise",
  "title": "GitHub Actions are restricted at enterprise level",
  "remediation": "Enterprise settings > Policies > Actions: allow enterprise and select non-enterprise actions only.",
  "dataSource": {
    "type": "enterprise-actions-permissions"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "allowed": {
        "type": "array",
        "items": { "type": "string", "enum": ["all", "local_only", "selected"] },
        "minItems": 1
      }
    },
    "required": ["allowed"],
    "additionalProperties": false
  }
}
